# Run Empathika on boot (Ubuntu). Copy to /etc/systemd/system/ and adjust paths/user:
#   sudo cp deploy/empathika.service /etc/systemd/system/ && sudo systemctl enable --now empathika
[Unit]
Description=Empathika voice assistant
After=network-online.target sound.target docker.service
Wants=network-online.target

[Service]
User=empathika
WorkingDirectory=/opt/empathika-assistant
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
