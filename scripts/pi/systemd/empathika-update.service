[Unit]
Description=Empathika: update from GitHub on request
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/empathika/empathika-update.py
TimeoutStartSec=75min
# The setup it runs restarts Empathika's container: keep this service out of its way.
KillMode=process
