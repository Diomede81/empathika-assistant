# =====================================================================================
#  Empathika trial on Max's box: every setting to add, in one place.
#
#  1. Copy Max's .env into the empathika-assistant folder (on the box).
#     (Comments must stay on their own lines: Docker reads anything after "=" as the value.)
#  2. Paste this whole block AT THE END of it. When a setting appears twice, the last one
#     wins, so these replace Max's values without hunting for them; an empty value means
#     "use Empathika's own default" (e.g. her female voice instead of Max's).
#  3. Fill in the lines marked  <-- FILL IN , then run:  sudo ./scripts/pi/setup.sh
#     The setup warns if anything important is still missing.
# =====================================================================================

# ---------- Real-time voice: Gemini Live, female voice ----------
VOICE_MODE=realtime
REALTIME_PROVIDER=gemini
# <-- FILL IN, unless Max's .env already has a GEMINI_API_KEY line with a key (then leave this as it is):
#     remove the "# " below and paste the key (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# female; also try Aoede, Leda or Zephyr
REALTIME_VOICE=Kore
# British accent
REALTIME_LANGUAGE=en-GB
# empty = Empathika's default Gemini Live model
REALTIME_MODEL=
# empty = Empathika's calm, gentle style (not Max's "witty butler")
REALTIME_STYLE=

# ---------- Normal (non-real-time) voice, if VOICE_MODE is ever set back to pipeline ----------
# empty = Empathika's female default for the chosen voice service
TTS_VOICE=
# empty = no extra delivery instructions from Max
TTS_INSTRUCTIONS=

# ---------- Empathika's own rules (never Max's) ----------
# empty = Empathika's care-home rules (no medical advice, privacy...)
LLM_SYSTEM_PROMPT=

# ---------- Wake word and greeting ----------
# until "Hey Empathika" is trained; then: WAKEWORD_NAMES=hey_empathika
WAKEWORD_NAMES=hey_max
# said after a lone "Hey Empathika"; "off" = no greeting
WAKE_GREETING=Hi, how can I help?

# ---------- Network name of the box ----------
# keeps http://max.local:8099; use "empathika" for empathika.local
EMPATHIKA_HOSTNAME=max
# match the name above
CONTROL_PANEL_URL=http://max.local:8099

# ---------- The Empathika care app ----------
# Until the real app exists: the practice app (npm run mock-app on your computer, port 8090).
# From the box, use your computer's address, e.g. http://192.168.1.20:8090/mcp
# <-- FILL IN
EMPATHIKA_APP_MCP_URL=
# the practice app's token; the real app will give you one
EMPATHIKA_APP_TOKEN=practice
# the practice app's resident
RESIDENT_ID=res-001
MEMORY_BACKUP_MINUTES=60
FAMILY_UPDATES_MINUTES=5

# ---------- Staff sessions ----------
# staff and their PINs are added on the control panel (Staff tab)
STAFF_SESSION_MINUTES=5

# ---------- Security (required in a care home) ----------
# <-- FILL IN, unless Max's .env already has a PANEL_PASSWORD (then leave this as it is):
#     remove the "# " below and choose a password for the control panel
# PANEL_PASSWORD=
# MEMORY_KEY: keep Max's line if it has one. Otherwise generate one (openssl rand -base64 32),
# put it here and keep a copy somewhere safe: without it the memories can't be opened.
# MEMORY_KEY=

# ---------- Start-up ----------
# the setup also fixes this by itself
COMPOSE_PROFILES=empathika
